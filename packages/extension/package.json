{
    "name": "vscode-alloy-lsp",
    "description": "The extension specific package",
    "version": "0.0.1",
    "displayName": "alloy-lsp",
    "type": "module",
    "engines": {
        "vscode": "^1.91.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "languages": [{
            "id": "alloy-lsp",
            "aliases": ["Alloy LSP", "alloy-lsp"],
            "extensions": [".als"],
            "configuration": "./language-configuration.json"
        }],
        "configuration": {
            "title": "Alloy",
            "properties": {
                "alloy-lsp.inlayHints.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show the inferred types of let bindings and of names declared with = as inlay hints."
                },
                "alloy-lsp.analyzer.jar": {
                    "type": "string",
                    "default": "",
                    "description": "Path to an Alloy 6 jar to run commands with instead of the one this extension ships (Alloy 6.2.0). Leave empty to use the shipped jar."
                },
                "alloy-lsp.analyzer.java": {
                    "type": "string",
                    "default": "java",
                    "description": "The java executable that runs the Alloy jar."
                },
                "alloy-lsp.analyzer.timeoutSeconds": {
                    "type": "number",
                    "default": 300,
                    "minimum": 0,
                    "description": "Seconds a run or check may take before it is stopped; 0 means no limit. Also set with the 'Alloy: Set Run Timeout' command."
                }
            }
        },
        "commands": [{
            "command": "alloy-lsp.setTimeout",
            "title": "Set Run Timeout",
            "category": "Alloy"
        }],
        "grammars": [{
            "language": "alloy-lsp",
            "scopeName": "source.alloy-lsp",
            "path": "syntaxes/alloy-lsp.tmLanguage.json"
        }]
    },
    "activationEvents": [
        "onLanguage:alloy-lsp"
    ],
    "main": "./out/extension/main.cjs",
    "scripts": {
        "clean": "shx rm -fr *.tsbuildinfo out syntaxes",
        "vscode:prepublish": "npm run build",
        "build:prepare": "shx mkdir -p ./syntaxes/ && shx cp -f ../language/syntaxes/alloy-lsp.tmLanguage.json ./syntaxes/alloy-lsp.tmLanguage.json",
        "fetch:alloy": "node scripts/fetch-alloy.mjs",
        "build": "npm run fetch:alloy && npm run build:prepare && tsc -b tsconfig.json && node esbuild.mjs",
        "build:clean": "npm run clean && npm run build",
        "watch": "npm run build:prepare && concurrently -n tsc,esbuild -c blue,yellow \"tsc -b tsconfig.json --watch\" \"node esbuild.mjs --watch\""
    },
    "dependencies": {
        "alloy-lsp-language": "0.0.1",
        "vscode-languageclient": "~10.1.0",
        "vscode-languageserver": "~10.1.0"
    },
    "devDependencies": {
        "@types/vscode": "~1.91.0",
        "concurrently": "~10.0.4",
        "esbuild": "0.28.2"
    },
    "vsce": {
      "dependencies": false
    }
}
